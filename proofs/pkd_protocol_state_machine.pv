(*= https://raw.githubusercontent.com/fedi-e2ee/public-key-directory-specification/refs/heads/main/Specification.md#addkey *)
(*# The first AddKey for any given Actor MUST be self-signed by the same public key being added. *)

(*= https://raw.githubusercontent.com/fedi-e2ee/public-key-directory-specification/refs/heads/main/Specification.md#revokekey *)
(*# Attempting to issue a RevokeKey MUST fail unless there is another public key associated with this Actor. *)

(* TYPE DECLARATIONS *)
type actor_id.
type public_key.
type secret_key.
type signature.
type message.

free c: channel.
free verified_c: channel [private].

fun pk(secret_key): public_key.
fun sign(message, secret_key): signature.
reduc forall m: message, sk: secret_key;
  verify(m, sign(m, sk), pk(sk)) = true.

fun AddKeyMsg(actor_id, public_key): message.
fun RevokeKeyMsg(actor_id, public_key): message.

table active_keys(actor_id, public_key).

event OuterActorAuthenticated(actor_id).
event OuterActorMatched(actor_id).
event SelfSignedAccepted(actor_id, public_key).
event FirstKeyAdded(actor_id, public_key).
event AuthorizedByExisting(actor_id, public_key, public_key).
event SubsequentKeyAdded(actor_id, public_key, public_key).
event RevocationAuthorizedByDifferentKey(actor_id, public_key, public_key).
event KeyRevoked(actor_id, public_key, public_key).

(* SECURITY QUERIES *)

query actor: actor_id, pk_val: public_key;
  event(FirstKeyAdded(actor, pk_val)) ==>
    event(SelfSignedAccepted(actor, pk_val)).

query actor: actor_id, new_pk: public_key, auth_pk: public_key;
  event(SubsequentKeyAdded(actor, new_pk, auth_pk)) ==>
    event(AuthorizedByExisting(actor, new_pk, auth_pk)).

query actor: actor_id, revoke_pk: public_key, auth_pk: public_key;
  event(KeyRevoked(actor, revoke_pk, auth_pk)) ==>
    event(RevocationAuthorizedByDifferentKey(actor, revoke_pk, auth_pk)).

query actor: actor_id, pk_val: public_key;
  event(FirstKeyAdded(actor, pk_val)) ==>
    (event(OuterActorAuthenticated(actor)) && event(OuterActorMatched(actor))).

query actor: actor_id, revoke_pk: public_key, auth_pk: public_key;
  event(KeyRevoked(actor, revoke_pk, auth_pk)) ==>
    (event(OuterActorAuthenticated(actor)) && event(OuterActorMatched(actor))).

free honest_actor: actor_id.
query pk_val: public_key;
  event(FirstKeyAdded(honest_actor, pk_val)) &&
  attacker(pk_val).

let PKD_ProcessAddKey =
  in(verified_c, (
    outer_actor: actor_id,
    inner_actor: actor_id,
    new_pk: public_key,
    inner_sig: signature
  ));
  event OuterActorAuthenticated(outer_actor);
  if outer_actor = inner_actor then
    event OuterActorMatched(inner_actor);
    let msg = AddKeyMsg(inner_actor, new_pk) in
    get active_keys(=inner_actor, auth_pk) in
      if auth_pk <> new_pk then
        if verify(msg, inner_sig, auth_pk) = true then
          insert active_keys(inner_actor, new_pk);
          event AuthorizedByExisting(inner_actor, new_pk, auth_pk);
          event SubsequentKeyAdded(inner_actor, new_pk, auth_pk)
    else
      if verify(msg, inner_sig, new_pk) = true then
        insert active_keys(inner_actor, new_pk);
        event SelfSignedAccepted(inner_actor, new_pk);
        event FirstKeyAdded(inner_actor, new_pk).

let PKD_ProcessRevokeKey =
  in(verified_c, (
    outer_actor: actor_id,
    inner_actor: actor_id,
    revoke_pk: public_key,
    inner_sig: signature
  ));
  event OuterActorAuthenticated(outer_actor);
  if outer_actor = inner_actor then
    event OuterActorMatched(inner_actor);
    let msg = RevokeKeyMsg(inner_actor, revoke_pk) in
    get active_keys(=inner_actor, =revoke_pk) in
      get active_keys(=inner_actor, auth_pk) in
        if auth_pk <> revoke_pk then
          if verify(msg, inner_sig, auth_pk) = true then
            event RevocationAuthorizedByDifferentKey(
              inner_actor, revoke_pk, auth_pk
            );
            event KeyRevoked(inner_actor, revoke_pk, auth_pk).

let HonestLifecycle(
  actor: actor_id,
  first_sk: secret_key,
  second_sk: secret_key
) =
  let first_pk = pk(first_sk) in
  let second_pk = pk(second_sk) in

  let m1 = AddKeyMsg(actor, first_pk) in
  out(verified_c, (
    actor, actor, first_pk, sign(m1, first_sk)
  ));

  let m2 = AddKeyMsg(actor, second_pk) in
  out(verified_c, (
    actor, actor, second_pk, sign(m2, first_sk)
  ));

  let m3 = RevokeKeyMsg(actor, first_pk) in
  out(verified_c, (
    actor, actor, first_pk, sign(m3, second_sk)
  )).

let AttackerLifecycle(
  actor: actor_id,
  first_sk: secret_key,
  second_sk: secret_key
) =
  let first_pk = pk(first_sk) in
  let second_pk = pk(second_sk) in
  out(c, actor);
  out(c, first_sk);
  out(c, first_pk);
  out(c, second_sk);
  out(c, second_pk);

  let m1 = AddKeyMsg(actor, first_pk) in
  out(verified_c, (
    actor, actor, first_pk, sign(m1, first_sk)
  ));

  let m2 = AddKeyMsg(actor, second_pk) in
  out(verified_c, (
    actor, actor, second_pk, sign(m2, first_sk)
  )).

process
  new other_actor: actor_id;
  new other_first_sk: secret_key;
  new other_second_sk: secret_key;

  new attacker_actor: actor_id;
  new attacker_first_sk: secret_key;
  new attacker_second_sk: secret_key;

  (
    !PKD_ProcessAddKey |
    !PKD_ProcessRevokeKey |
    HonestLifecycle(other_actor, other_first_sk, other_second_sk) |
    AttackerLifecycle(attacker_actor, attacker_first_sk, attacker_second_sk)
  )
