(*= https://raw.githubusercontent.com/fedi-e2ee/public-key-directory-specification/refs/heads/main/Specification.md#race-condition-between-successful-burndown-and-subsequent-addkey *)
(*# After a successful BurnDown, the user's set of public keys is empty, *)
(*# which means the system will tolerate a self-signed AddKey. *)

(*= https://raw.githubusercontent.com/fedi-e2ee/public-key-directory-specification/refs/heads/main/Specification.md#parallel-enrollment-race-conditions *)
(*# Implementations MUST ensure atomic processing of Protocol Messages *)
(*# to prevent TOCTOU vulnerabilities. *)

(* TYPE DECLARATIONS *)
type actor_id.
type public_key.
type message_id.

table committed_messages(message_id).
table burned_down(actor_id).
table fireproof_actors(actor_id).

event MessageCommitted(message_id).
event PreviouslyCommitted(message_id).
event ReplayRejected(message_id).
event BurnDownCommitted(actor_id).
event BurnDownStateObserved(actor_id).
event FireproofCommitted(actor_id).
event FireproofStateObserved(actor_id).
event SelfSignedAddAfterBurnDown(actor_id, public_key).
event BurnDownBlockedFireproof(actor_id).

(* SECURITY QUERIES *)

query msg: message_id;
  event(ReplayRejected(msg)) ==> event(PreviouslyCommitted(msg)).

query actor: actor_id, new_pk: public_key;
  event(SelfSignedAddAfterBurnDown(actor, new_pk)) ==>
    event(BurnDownStateObserved(actor)).

query actor: actor_id;
  event(BurnDownBlockedFireproof(actor)) ==>
    event(FireproofStateObserved(actor)).

query actor: actor_id;
  event(BurnDownCommitted(actor)) ==> true.

query actor: actor_id;
  event(FireproofCommitted(actor)) ==> true.

let CommitReplayProtected(msg: message_id) =
  get committed_messages(=msg) in
    event PreviouslyCommitted(msg);
    event ReplayRejected(msg)
  else
    insert committed_messages(msg);
    event MessageCommitted(msg).

let CommitBurnDown(actor: actor_id, msg: message_id) =
  get committed_messages(=msg) in
    event PreviouslyCommitted(msg);
    event ReplayRejected(msg)
  else
    get fireproof_actors(=actor) in
      event FireproofStateObserved(actor);
      event BurnDownBlockedFireproof(actor)
    else
      insert committed_messages(msg);
      insert burned_down(actor);
      event MessageCommitted(msg);
      event BurnDownCommitted(actor).

let CommitFireproof(actor: actor_id, msg: message_id) =
  get committed_messages(=msg) in
    event PreviouslyCommitted(msg);
    event ReplayRejected(msg)
  else
    insert committed_messages(msg);
    insert fireproof_actors(actor);
    event MessageCommitted(msg);
    event FireproofCommitted(actor).

let CommitSelfSignedAddAfterBurnDown(
  actor: actor_id, new_pk: public_key, msg: message_id
) =
  get committed_messages(=msg) in
    event PreviouslyCommitted(msg);
    event ReplayRejected(msg)
  else
    get burned_down(=actor) in
      event BurnDownStateObserved(actor);
      insert committed_messages(msg);
      event MessageCommitted(msg);
      event SelfSignedAddAfterBurnDown(actor, new_pk).

process
  new replay_msg: message_id;
  new actor_after_burndown: actor_id;
  new actor_fireproofed: actor_id;
  new burn_msg: message_id;
  new add_msg: message_id;
  new fireproof_msg: message_id;
  new blocked_burndown_msg: message_id;
  new attacker_pk: public_key;

  (
    CommitReplayProtected(replay_msg) |
    CommitReplayProtected(replay_msg) |

    CommitBurnDown(actor_after_burndown, burn_msg) |
    CommitSelfSignedAddAfterBurnDown(
      actor_after_burndown, attacker_pk, add_msg
    ) |

    CommitFireproof(actor_fireproofed, fireproof_msg) |
    CommitBurnDown(actor_fireproofed, blocked_burndown_msg)
  )
