(*= https://raw.githubusercontent.com/fedi-e2ee/public-key-directory-specification/refs/heads/main/Specification.md#handling-protocol-messages *)
(*# Every Protocol Message received by a Public Key Directory MUST be unique. *)

(*= https://raw.githubusercontent.com/fedi-e2ee/public-key-directory-specification/refs/heads/main/Specification.md#protocol-signatures *)
(*# The signed material includes context, action, message, and recent-merkle-root. *)

(* TYPE DECLARATIONS *)
type actor_id.
type public_key.
type secret_key.
type signature.
type merkle_root.
type timestamp.
type action.
type message_payload.
type context.
type pae_encoding.

free c: channel.

const PKD_CONTEXT: context.
const ACTION_ADD_KEY: action.
const ACTION_REVOKE_KEY: action.

fun pk(secret_key): public_key.
fun pae(context, action, message_payload, merkle_root): pae_encoding [data].

fun sign(pae_encoding, secret_key): signature.
reduc forall m: pae_encoding, sk: secret_key;
  verify_sig(m, sign(m, sk), pk(sk)) = true.

fun msg_hash(
  actor_id, context, action, message_payload, merkle_root, signature
): bitstring [data].

table processed_messages(bitstring).
table registered_keys(actor_id, public_key).

event SignatureVerified(
  actor_id, public_key, action, message_payload, merkle_root, signature
).
event MessageCommitted(
  actor_id, action, message_payload, merkle_root, signature, bitstring
).
event PreviouslyProcessed(
  actor_id, action, message_payload, merkle_root, signature, bitstring
).
event MessageAccepted(
  actor_id, action, message_payload, merkle_root, signature, bitstring
).
event MessageRejectedDuplicate(
  actor_id, action, message_payload, merkle_root, signature, bitstring
).
event ReplayAttempted(
  actor_id, action, message_payload, merkle_root, signature, bitstring
).

(* SECURITY QUERIES *)

query actor: actor_id, act: action, payload: message_payload,
      root: merkle_root, sig: signature, mhash: bitstring,
      auth_pk: public_key;
  event(MessageAccepted(actor, act, payload, root, sig, mhash)) ==>
    event(SignatureVerified(actor, auth_pk, act, payload, root, sig)).

query actor: actor_id, act: action, payload: message_payload,
      root: merkle_root, sig: signature, mhash: bitstring;
  event(MessageRejectedDuplicate(actor, act, payload, root, sig, mhash)) ==>
    event(PreviouslyProcessed(actor, act, payload, root, sig, mhash)).

query actor: actor_id, act: action, payload: message_payload,
      root: merkle_root, sig: signature, mhash: bitstring;
  event(ReplayAttempted(actor, act, payload, root, sig, mhash)) ==>
    event(PreviouslyProcessed(actor, act, payload, root, sig, mhash)).

(* The same signed blob must not verify under two different actions. *)
query actor: actor_id, auth_pk: public_key,
      payload: message_payload, root: merkle_root, sig: signature;
  event(SignatureVerified(
    actor, auth_pk, ACTION_ADD_KEY, payload, root, sig
  )) &&
  event(SignatureVerified(
    actor, auth_pk, ACTION_REVOKE_KEY, payload, root, sig
  )).

let PKD_ProcessMessage =
  in(c, (actor: actor_id, ctx: context, act: action,
         payload: message_payload, root: merkle_root,
         auth_pk: public_key, sig: signature));

  if ctx = PKD_CONTEXT then
    get registered_keys(=actor, =auth_pk) in
      let pae_msg = pae(ctx, act, payload, root) in
      if verify_sig(pae_msg, sig, auth_pk) = true then
        event SignatureVerified(
          actor, auth_pk, act, payload, root, sig
        );
        let mhash = msg_hash(actor, ctx, act, payload, root, sig) in
        get processed_messages(=mhash) in
          event PreviouslyProcessed(
            actor, act, payload, root, sig, mhash
          );
          event ReplayAttempted(
            actor, act, payload, root, sig, mhash
          );
          event MessageRejectedDuplicate(
            actor, act, payload, root, sig, mhash
          )
        else
          insert processed_messages(mhash);
          event MessageCommitted(
            actor, act, payload, root, sig, mhash
          );
          event MessageAccepted(
            actor, act, payload, root, sig, mhash
          );
          out(c, (actor, act, true)).

let HonestActor(
  actor: actor_id, sk: secret_key,
  act: action, payload: message_payload, root: merkle_root
) =
  let actor_pk = pk(sk) in
  let pae_msg = pae(PKD_CONTEXT, act, payload, root) in
  let sig = sign(pae_msg, sk) in
  out(c, (actor, PKD_CONTEXT, act, payload, root, actor_pk, sig)).

let AttackerReplay =
  in(c, (actor: actor_id, ctx: context, act: action,
         payload: message_payload, root: merkle_root,
         auth_pk: public_key, sig: signature));
  out(c, (actor, ctx, act, payload, root, auth_pk, sig)).

let AttackerActionSubstitution =
  in(c, (actor: actor_id, ctx: context, act: action,
         payload: message_payload, root: merkle_root,
         auth_pk: public_key, sig: signature));
  out(c, (
    actor, ctx, ACTION_REVOKE_KEY,
    payload, root, auth_pk, sig
  )).

process
  new honest_actor: actor_id;
  new honest_sk: secret_key;
  let honest_pk = pk(honest_sk) in
  insert registered_keys(honest_actor, honest_pk);

  new honest_payload: message_payload;
  new honest_root: merkle_root;

  new attacker_sk: secret_key;
  out(c, attacker_sk);
  out(c, pk(attacker_sk));

  out(c, honest_actor);
  out(c, honest_pk);

  (
    !PKD_ProcessMessage |
    HonestActor(
      honest_actor, honest_sk,
      ACTION_ADD_KEY, honest_payload, honest_root
    ) |
    !AttackerReplay |
    !AttackerActionSubstitution
  )
