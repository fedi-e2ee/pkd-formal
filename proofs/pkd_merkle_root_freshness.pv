(*= https://raw.githubusercontent.com/fedi-e2ee/public-key-directory-specification/refs/heads/main/Specification.md#recent-merkle-root-included-in-plaintext-commitments *)
(*# The selected recent Merkle root is accepted when it falls within any of *)
(*# the spec's recency rules (normal window, high-volume fallback, bootstrap). *)

(*= https://raw.githubusercontent.com/fedi-e2ee/public-key-directory-specification/refs/heads/main/Specification.md#protocol-signatures *)
(*# Signatures are computed over PAE of: !pkd-context, action, message, *)
(*# recent-merkle-root. *)

(* TYPE DECLARATIONS *)
type actor_id.
type public_key.
type secret_key.
type signature.
type merkle_root.
type action.
type message_payload.
type context.
type pae_encoding.

free c: channel.

const PKD_CONTEXT: context.
const ACTION_ADD_KEY: action.

fun pk(secret_key): public_key.

fun pae_sign(
  context, action, message_payload, merkle_root, secret_key
): signature.
reduc forall ctx: context, act: action, msg: message_payload,
      root: merkle_root, sk: secret_key;
  pae_verify(
    ctx, act, msg, root,
    pae_sign(ctx, act, msg, root, sk),
    pk(sk)
  ) = true.

table low_volume_roots(merkle_root).
table high_volume_roots(merkle_root).
table bootstrap_roots(merkle_root).

event MessageAccepted(actor_id, merkle_root).
event MessageRejectedStale(actor_id, merkle_root).
event RootAcceptedByPolicy(merkle_root).
event LowVolumeAccepted(merkle_root).
event HighVolumeAccepted(merkle_root).
event BootstrapAccepted(merkle_root).
event SignatureBoundToRoot(actor_id, merkle_root).

(* SECURITY QUERIES *)

query actor: actor_id, root: merkle_root;
  event(MessageAccepted(actor, root)) ==>
    event(RootAcceptedByPolicy(root)).

query actor: actor_id, root: merkle_root;
  event(MessageAccepted(actor, root)) ==>
    event(SignatureBoundToRoot(actor, root)).

query root: merkle_root;
  event(LowVolumeAccepted(root)) ==> true.

query root: merkle_root;
  event(HighVolumeAccepted(root)) ==> true.

query root: merkle_root;
  event(BootstrapAccepted(root)) ==> true.

query actor: actor_id, root: merkle_root;
  event(MessageRejectedStale(actor, root)) ==> true.

let PKD_ProcessMessage =
  in(c, (actor: actor_id, msg_content: message_payload,
         recent_root: merkle_root,
         sig: signature, signer_pk: public_key));

  if pae_verify(
    PKD_CONTEXT, ACTION_ADD_KEY, msg_content,
    recent_root, sig, signer_pk
  ) = true then
    event SignatureBoundToRoot(actor, recent_root);
    get low_volume_roots(=recent_root) in
      event LowVolumeAccepted(recent_root);
      event RootAcceptedByPolicy(recent_root);
      event MessageAccepted(actor, recent_root);
      out(c, (actor, true))
    else
      get high_volume_roots(=recent_root) in
        event HighVolumeAccepted(recent_root);
        event RootAcceptedByPolicy(recent_root);
        event MessageAccepted(actor, recent_root);
        out(c, (actor, true))
      else
        get bootstrap_roots(=recent_root) in
          event BootstrapAccepted(recent_root);
          event RootAcceptedByPolicy(recent_root);
          event MessageAccepted(actor, recent_root);
          out(c, (actor, true))
        else
          event MessageRejectedStale(actor, recent_root).

let HonestActor(
  actor: actor_id, sk: secret_key, recent_root: merkle_root
) =
  let actor_pk = pk(sk) in
  new msg_content: message_payload;
  let sig = pae_sign(
    PKD_CONTEXT, ACTION_ADD_KEY, msg_content, recent_root, sk
  ) in
  out(c, (actor, msg_content, recent_root, sig, actor_pk)).

let AttackerStaleReplay(
  target: actor_id, attacker_sk: secret_key, stale_root: merkle_root
) =
  let attacker_pk = pk(attacker_sk) in
  new msg_content: message_payload;
  let sig = pae_sign(
    PKD_CONTEXT, ACTION_ADD_KEY, msg_content, stale_root, attacker_sk
  ) in
  out(c, (target, msg_content, stale_root, sig, attacker_pk)).

process
  new actor: actor_id;
  new actor_sk: secret_key;
  new attacker_sk: secret_key;

  new low_root: merkle_root;
  new high_root: merkle_root;
  new zero_root: merkle_root;
  new stale_root: merkle_root;

  insert low_volume_roots(low_root);
  insert high_volume_roots(high_root);
  insert bootstrap_roots(zero_root);

  out(c, actor);
  out(c, pk(attacker_sk));

  (
    !PKD_ProcessMessage |
    HonestActor(actor, actor_sk, low_root) |
    HonestActor(actor, actor_sk, high_root) |
    HonestActor(actor, actor_sk, zero_root) |
    AttackerStaleReplay(actor, attacker_sk, stale_root)
  )
