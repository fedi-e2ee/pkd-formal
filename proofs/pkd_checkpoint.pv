(*= https://raw.githubusercontent.com/fedi-e2ee/public-key-directory-specification/refs/heads/main/Specification.md#checkpoint *)
(*# A Checkpoint commits one directory's view of another directory's Merkle root. *)

(*= https://raw.githubusercontent.com/fedi-e2ee/public-key-directory-specification/refs/heads/main/Specification.md#checkpoint-validation-steps *)
(*# Step 2: Verify that message.from-directory exists strictly within an *)
(*# allow-list of accepted directories. *)
(*# Step 3: Verify that message.to-directory matches the current Public Key *)
(*# Directory's canonical URL. *)
(*# Step 4: Verify that message.time is within a reasonably recent time *)
(*# window. *)
(*# Step 5: Verify that message.to-validated-root is recent. *)
(*# Step 6: Asynchronously fetch the current public key from the sender's PKD, *)
(*# compare with message.from-public-key. If they are not identical at the time *)
(*# of insertion, abort. *)

(* TYPE DECLARATIONS *)
type directory.
type public_key.
type secret_key.
type signature.
type merkle_root.
type timestamp.
type transport.
type payload.
type message.

free c: channel.
free local_directory: directory.
(* Only operator-driven processes may register or rotate peer keys. *)
free peer_registration: channel [private].

const PLAINTEXT: transport.
const ENCRYPTED: transport.

fun pk(secret_key): public_key.
fun sign(payload, secret_key): signature.
reduc forall m: payload, sk: secret_key;
  verify(m, sign(m, sk), pk(sk)) = true.

fun CheckpointPayload(
  directory, merkle_root, public_key,
  directory, merkle_root, timestamp
): payload [data].

fun CheckpointMsg(
  directory, merkle_root, public_key,
  directory, merkle_root, timestamp, signature
): message [data].

table recent_roots(merkle_root).
table validated_roots(merkle_root).
table fresh_timestamps(timestamp).
table peer_allowlist(directory, public_key).

event RecentMerkleRootAccepted(merkle_root).
event StaleCheckpointRejected(merkle_root).
event RecipientDirectoryMatched(directory).
event WrongRecipientRejected(directory).
event CheckpointTimeAccepted(timestamp).
event StaleTimestampRejected(timestamp).
event ValidatedRecipientRootAccepted(merkle_root).
event StaleValidatedRootRejected(merkle_root).
event AllowlistedSender(directory, public_key).
event CheckpointSignatureVerified(
  directory, merkle_root, public_key, directory, merkle_root
).
event CheckpointAccepted(
  directory, merkle_root, public_key,
  directory, merkle_root, timestamp, merkle_root, transport
).
event TransportAccepted(transport).
event PeerRegistered(directory, public_key).
event AttackerCheckpointBlocked(directory).

(* SECURITY QUERIES *)

(* An accepted checkpoint's caller-side recent-merkle-root was admitted. *)
query from_dir: directory, from_root: merkle_root,
      from_pk: public_key, to_dir: directory,
      to_root: merkle_root, ts: timestamp,
      recent_root: merkle_root,
      t: transport;
  event(CheckpointAccepted(
    from_dir, from_root, from_pk,
    to_dir, to_root, ts, recent_root, t
  )) ==> event(RecentMerkleRootAccepted(recent_root)).

(* An accepted checkpoint's sender-directory was allowlisted under the
   public key that actually authenticated the payload. *)
query from_dir: directory, from_root: merkle_root,
      from_pk: public_key, to_dir: directory,
      to_root: merkle_root, ts: timestamp,
      recent_root: merkle_root,
      t: transport;
  event(CheckpointAccepted(
    from_dir, from_root, from_pk,
    to_dir, to_root, ts, recent_root, t
  )) ==> event(AllowlistedSender(from_dir, from_pk)).

(* An accepted checkpoint targeted the recipient PKD's canonical directory. *)
query from_dir: directory, from_root: merkle_root,
      from_pk: public_key, to_dir: directory,
      to_root: merkle_root, ts: timestamp,
      recent_root: merkle_root,
      t: transport;
  event(CheckpointAccepted(
    from_dir, from_root, from_pk,
    to_dir, to_root, ts, recent_root, t
  )) ==> event(RecipientDirectoryMatched(to_dir)).

(* An accepted checkpoint carried a recent timestamp. *)
query from_dir: directory, from_root: merkle_root,
      from_pk: public_key, to_dir: directory,
      to_root: merkle_root, ts: timestamp,
      recent_root: merkle_root,
      t: transport;
  event(CheckpointAccepted(
    from_dir, from_root, from_pk,
    to_dir, to_root, ts, recent_root, t
  )) ==> event(CheckpointTimeAccepted(ts)).

(* An accepted checkpoint carried a recent to-validated-root. *)
query from_dir: directory, from_root: merkle_root,
      from_pk: public_key, to_dir: directory,
      to_root: merkle_root, ts: timestamp,
      recent_root: merkle_root,
      t: transport;
  event(CheckpointAccepted(
    from_dir, from_root, from_pk,
    to_dir, to_root, ts, recent_root, t
  )) ==> event(ValidatedRecipientRootAccepted(to_root)).

(* An accepted checkpoint's payload signature was verified under the
   allowlisted sender key. *)
query from_dir: directory, from_root: merkle_root,
      from_pk: public_key, to_dir: directory,
      to_root: merkle_root, ts: timestamp,
      recent_root: merkle_root,
      t: transport;
  event(CheckpointAccepted(
    from_dir, from_root, from_pk,
    to_dir, to_root, ts, recent_root, t
  )) ==> event(CheckpointSignatureVerified(
    from_dir, from_root, from_pk, to_dir, to_root
  )).

(* Both plaintext and encrypted transports route to the same callback. *)
query t: transport;
  event(TransportAccepted(t)) ==> true.

(* Stale top-level roots and unauthorized senders are both reachable. *)
query recent_root: merkle_root;
  event(StaleCheckpointRejected(recent_root)) ==> true.

query to_dir: directory;
  event(WrongRecipientRejected(to_dir)) ==> true.

query ts: timestamp;
  event(StaleTimestampRejected(ts)) ==> true.

query to_root: merkle_root;
  event(StaleValidatedRootRejected(to_root)) ==> true.

query from_dir: directory;
  event(AttackerCheckpointBlocked(from_dir)) ==> true.

(* An allowlisted honest peer's signing key remains secret. *)
free honest_peer_sk: secret_key [private].
query attacker(honest_peer_sk).

(* An attacker-controlled directory cannot forge an accepted checkpoint
   that claims to originate from a pre-registered honest peer's key. *)
free attacker_dir: directory.
free attacker_sk: secret_key [private].
query from_root: merkle_root, to_dir: directory,
      to_root: merkle_root, ts: timestamp,
      recent_root: merkle_root,
      t: transport;
  event(CheckpointAccepted(
    attacker_dir, from_root, pk(honest_peer_sk),
    to_dir, to_root, ts, recent_root, t
  )).

let PKD_ProcessCheckpoint =
  in(c, (t: transport, recent_root: merkle_root, raw: message));
  get recent_roots(=recent_root) in
    event RecentMerkleRootAccepted(recent_root);
    let CheckpointMsg(
      from_dir, from_root, from_pk,
      to_dir, to_root, ts, sig
    ) = raw in
    if to_dir = local_directory then
      event RecipientDirectoryMatched(to_dir);
      get fresh_timestamps(=ts) in
        event CheckpointTimeAccepted(ts);
        get validated_roots(=to_root) in
          event ValidatedRecipientRootAccepted(to_root);
          get peer_allowlist(=from_dir, =from_pk) in
            event AllowlistedSender(from_dir, from_pk);
            let payload_bytes = CheckpointPayload(
              from_dir, from_root, from_pk, to_dir, to_root, ts
            ) in
            if verify(payload_bytes, sig, from_pk) = true then
              event TransportAccepted(t);
              event CheckpointSignatureVerified(
                from_dir, from_root, from_pk, to_dir, to_root
              );
              event CheckpointAccepted(
                from_dir, from_root, from_pk,
                to_dir, to_root, ts, recent_root, t
              );
              out(c, (t, ts))
          else
            event AttackerCheckpointBlocked(from_dir)
        else
          event StaleValidatedRootRejected(to_root)
      else
        event StaleTimestampRejected(ts)
    else
      event WrongRecipientRejected(to_dir)
  else
    event StaleCheckpointRejected(recent_root).

(* Operator provisioning of a trusted peer directory. Only processes that
   hold the private peer_registration channel can add allowlist entries,
   so the attacker cannot register itself. *)
let PeerRegistrar =
  in(peer_registration, (peer_dir: directory, peer_pk: public_key));
  insert peer_allowlist(peer_dir, peer_pk);
  event PeerRegistered(peer_dir, peer_pk).

let HonestCheckpoint(
  t: transport, recent_root: merkle_root,
  from_dir: directory, from_sk: secret_key,
  to_dir: directory, to_root: merkle_root,
  ts: timestamp
) =
  let from_pk = pk(from_sk) in
  new from_root: merkle_root;
  let payload_bytes = CheckpointPayload(
    from_dir, from_root, from_pk, to_dir, to_root, ts
  ) in
  let sig = sign(payload_bytes, from_sk) in
  out(c, (
    t, recent_root,
    CheckpointMsg(
      from_dir, from_root, from_pk, to_dir, to_root, ts, sig
    )
  )).

(* Attacker tries to pass off its own directory as a checkpoint source. *)
let AttackerCheckpoint(
  t: transport, recent_root: merkle_root,
  attacker_dir_arg: directory, attacker_sk_arg: secret_key,
  target_dir: directory, target_root: merkle_root,
  ts: timestamp
) =
  let atk_pk = pk(attacker_sk_arg) in
  new from_root: merkle_root;
  let payload_bytes = CheckpointPayload(
    attacker_dir_arg, from_root, atk_pk, target_dir, target_root, ts
  ) in
  let sig = sign(payload_bytes, attacker_sk_arg) in
  out(c, (
    t, recent_root,
    CheckpointMsg(
      attacker_dir_arg, from_root, atk_pk,
      target_dir, target_root, ts, sig
    )
  )).

process
  new recent_root: merkle_root;
  new stale_root: merkle_root;
  new validated_root: merkle_root;
  new stale_validated_root: merkle_root;
  new fresh_ts: timestamp;
  new stale_ts: timestamp;
  new wrong_directory: directory;
  insert recent_roots(recent_root);
  insert validated_roots(validated_root);
  insert fresh_timestamps(fresh_ts);

  new peer_a_dir: directory;
  let peer_a_pk = pk(honest_peer_sk) in
  out(peer_registration, (peer_a_dir, peer_a_pk));

  new peer_b_dir: directory;
  new peer_b_sk: secret_key;
  let peer_b_pk = pk(peer_b_sk) in
  out(peer_registration, (peer_b_dir, peer_b_pk));

  out(c, peer_a_dir);
  out(c, peer_a_pk);
  out(c, peer_b_dir);
  out(c, peer_b_pk);
  out(c, recent_root);
  out(c, stale_root);
  out(c, local_directory);
  out(c, validated_root);
  out(c, stale_validated_root);
  out(c, fresh_ts);
  out(c, stale_ts);
  out(c, wrong_directory);

  out(c, attacker_dir);
  out(c, pk(attacker_sk));

  (
    !PKD_ProcessCheckpoint |
    !PeerRegistrar |
    HonestCheckpoint(
      PLAINTEXT, recent_root, peer_a_dir, honest_peer_sk,
      local_directory, validated_root, fresh_ts
    ) |
    HonestCheckpoint(
      ENCRYPTED, recent_root, peer_b_dir, peer_b_sk,
      local_directory, validated_root, fresh_ts
    ) |
    HonestCheckpoint(
      PLAINTEXT, stale_root, peer_a_dir, honest_peer_sk,
      local_directory, validated_root, fresh_ts
    ) |
    HonestCheckpoint(
      PLAINTEXT, recent_root, peer_a_dir, honest_peer_sk,
      wrong_directory, validated_root, fresh_ts
    ) |
    HonestCheckpoint(
      PLAINTEXT, recent_root, peer_a_dir, honest_peer_sk,
      local_directory, validated_root, stale_ts
    ) |
    HonestCheckpoint(
      PLAINTEXT, recent_root, peer_a_dir, honest_peer_sk,
      local_directory, stale_validated_root, fresh_ts
    ) |
    !AttackerCheckpoint(
      PLAINTEXT, recent_root, attacker_dir, attacker_sk,
      local_directory, validated_root, fresh_ts
    )
  )
