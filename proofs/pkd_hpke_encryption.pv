(*= https://raw.githubusercontent.com/fedi-e2ee/public-key-directory-specification/refs/heads/main/Specification.md#protocol-messages *)
(*# Protocol messages that originate client-side MUST be encrypted using HPKE. *)

(*= https://raw.githubusercontent.com/fedi-e2ee/public-key-directory-specification/refs/heads/main/Specification.md#cryptography-protocols *)
(*# HPKE Suite: X-Wing, HKDF-SHA256, ChaCha20Poly1305 *)

(* TYPE DECLARATIONS *)
type x25519_secret.
type x25519_public.
type ed25519_secret.
type ed25519_public.
type signature.
type encapsulated_key.
type ciphertext.
type aad.
type info.
type key_id.
type protocol_message.

free c: channel.
free pkd_internal: channel [private].

const HPKE_INFO: info.

fun x25519_pk(x25519_secret): x25519_public.

fun ed25519_pk(ed25519_secret): ed25519_public.
fun sign(protocol_message, ed25519_secret): signature.
reduc forall m: protocol_message, sk: ed25519_secret;
  verify(m, sign(m, sk), ed25519_pk(sk)) = true.

fun hpke_encap(x25519_public): encapsulated_key.
fun hpke_seal(
  x25519_public, encapsulated_key, protocol_message, info, aad
): ciphertext.
reduc forall sk: x25519_secret, encap: encapsulated_key,
      msg: protocol_message, i: info, a: aad;
  hpke_open(
    sk,
    encap,
    hpke_seal(x25519_pk(sk), encap, msg, i, a),
    i,
    a
  ) = msg.

fun compute_key_id(x25519_public): key_id [data].
fun aad_from_key_id(key_id): aad [data].

table registered_client_keys(ed25519_public).

event ClientEncrypted(
  protocol_message, x25519_public, ed25519_public,
  encapsulated_key, ciphertext
).
event PKDDecrypted(
  protocol_message, x25519_public, encapsulated_key, ciphertext
).
event PKDAuthenticated(
  protocol_message, ed25519_public, encapsulated_key, ciphertext
).
event InstanceRelayed(encapsulated_key, ciphertext).

(* SECURITY QUERIES *)

free pkd_sk: x25519_secret [private].
query attacker(pkd_sk).

free honest_client_sk: ed25519_secret [private].
query attacker(honest_client_sk).

free secret_msg: protocol_message [private].
query attacker(secret_msg).

query msg: protocol_message, client_pk: ed25519_public,
      pkd_pk: x25519_public, encap: encapsulated_key,
      ct: ciphertext;
  event(PKDAuthenticated(msg, client_pk, encap, ct)) ==>
    event(ClientEncrypted(msg, pkd_pk, client_pk, encap, ct)).

let Client_EncryptMessage(
  pkd_pk: x25519_public, msg: protocol_message,
  client_sk: ed25519_secret
) =
  let client_pk = ed25519_pk(client_sk) in
  let kid = compute_key_id(pkd_pk) in
  let a = aad_from_key_id(kid) in
  let sig = sign(msg, client_sk) in
  let encap = hpke_encap(pkd_pk) in
  let ct = hpke_seal(pkd_pk, encap, msg, HPKE_INFO, a) in
  event ClientEncrypted(msg, pkd_pk, client_pk, encap, ct);
  out(c, (encap, ct, sig, client_pk)).

let Instance_Relay =
  in(c, (
    encap: encapsulated_key, ct: ciphertext,
    sig: signature, client_pk: ed25519_public
  ));
  event InstanceRelayed(encap, ct);
  out(c, (encap, ct, sig, client_pk)).

let PKD_DecryptMessage(pkd_secret: x25519_secret) =
  let pkd_pk = x25519_pk(pkd_secret) in
  let kid = compute_key_id(pkd_pk) in
  let a = aad_from_key_id(kid) in

  in(c, (
    encap: encapsulated_key, ct: ciphertext,
    sig: signature, client_pk: ed25519_public
  ));

  let msg = hpke_open(pkd_secret, encap, ct, HPKE_INFO, a) in
  event PKDDecrypted(msg, pkd_pk, encap, ct);

  if verify(msg, sig, client_pk) = true then
    get registered_client_keys(=client_pk) in
      event PKDAuthenticated(msg, client_pk, encap, ct);
      out(pkd_internal, (msg, client_pk)).

process
  let pkd_public = x25519_pk(pkd_sk) in
  let pkd_kid = compute_key_id(pkd_public) in

  let client_pk = ed25519_pk(honest_client_sk) in
  insert registered_client_keys(client_pk);

  new attacker_e_sk: ed25519_secret;
  out(c, attacker_e_sk);
  out(c, ed25519_pk(attacker_e_sk));

  out(c, pkd_public);
  out(c, pkd_kid);
  out(c, client_pk);

  (
    Client_EncryptMessage(pkd_public, secret_msg, honest_client_sk) |
    !Instance_Relay |
    !PKD_DecryptMessage(pkd_sk)
  )
